# Safe configuration template only; copy to .env during implementation.
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_TOPIC_PREFIX=smartparking/btech-7f3a/lot-a
MQTT_CLIENT_ID=smartparking-backend
MQTT_USERNAME=
MQTT_PASSWORD=

# python-dotenv expands LOCALAPPDATA on Windows. Never put the live DB in OneDrive.
DATABASE_PATH=${LOCALAPPDATA}/SmartParking/parking.db
MODEL_PATH=ml/artifacts/model.joblib
API_BASE_URL=http://127.0.0.1:8000
